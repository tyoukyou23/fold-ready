{
  "compilerOptions": {
    "target": "ES2019",
    "module": "ESNext",
    "moduleResolution": "Bundler",
    "jsx": "react-jsx",
    "strict": true,
    "declaration": true,
    "esModuleInterop": true,
    "skipLibCheck": true,
    "lib": [
      "DOM",
      "DOM.Iterable",
      "ES2020"
    ],
    "types": [
      "vite/client"
    ],
    "baseUrl": ".",
    "paths": {
      "fold-ready": [
        "src/index.ts"
      ],
      "fold-ready/devices": [
        "src/devices.ts"
      ],
      "fold-ready/tailwind": [
        "src/tailwind.ts"
      ]
    }
  },
  "include": [
    "src",
    "demo",
    "tests"
  ]
}
