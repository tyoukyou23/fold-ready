{
  "name": "fold-ready",
  "version": "0.1.1",
  "description": "Make web apps feel native on foldables and wide touch screens (iPhone Duo, iPad, Android foldables): decide by input, not width — docking panes, unfold-safe scroll, visible-viewport units, Safari toolbar tint, and a hover-only audit. Ships Safari measurements of iPhone Duo.",
  "license": "MIT",
  "author": "tyoukyou23",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/tyoukyou23/fold-ready.git"
  },
  "homepage": "https://tyoukyou23.github.io/fold-ready/",
  "keywords": [
    "react",
    "foldable",
    "iphone-duo",
    "responsive",
    "adaptive",
    "touch",
    "hover",
    "split-view",
    "list-detail",
    "viewport",
    "safari",
    "tailwind"
  ],
  "type": "module",
  "sideEffects": [
    "*.css"
  ],
  "main": "./dist/index.cjs",
  "module": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "import": "./dist/index.js",
      "require": "./dist/index.cjs"
    },
    "./tailwind": {
      "types": "./dist/tailwind.d.ts",
      "import": "./dist/tailwind.js",
      "require": "./dist/tailwind.cjs"
    },
    "./devices": {
      "types": "./dist/devices.d.ts",
      "import": "./dist/devices.js",
      "require": "./dist/devices.cjs"
    },
    "./tailwind.css": "./tailwind.css"
  },
  "files": [
    "dist",
    "tailwind.css",
    "README.md",
    "README.ja.md",
    "LICENSE"
  ],
  "scripts": {
    "build": "node -e \"require('fs').rmSync('dist',{recursive:true,force:true})\" && tsup",
    "prepare": "npm run build",
    "prepublishOnly": "npm run typecheck && npm test",
    "dev": "vite demo",
    "demo:build": "vite build demo --outDir ../demo-dist --emptyOutDir",
    "typecheck": "tsc --noEmit",
    "test": "vitest run"
  },
  "peerDependencies": {
    "react": ">=17",
    "react-dom": ">=17"
  },
  "devDependencies": {
    "@types/node": "^22.20.5",
    "@types/react": "^18.3.31",
    "@types/react-dom": "^18.3.7",
    "@vitejs/plugin-react": "^6.1.1",
    "jsdom": "^25.0.1",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "tsup": "^8.5.1",
    "typescript": "^5.9.3",
    "vite": "^8.3.2",
    "vitest": "^4.1.11"
  }
}